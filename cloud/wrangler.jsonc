// HELL on Cloudflare: one Worker serves the iPhone app (static files) and
// the small API that keeps secrets off the phone. Deployed by GitHub Actions
// (.github/workflows/cloud.yml); secrets are set in the Cloudflare
// dashboard (see cloud/README.md), never in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hell",
  // Your Cloudflare account (an ID, not a secret).
  "account_id": "87b7816e263c5e9466d675801800ccbe",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Serve HELL at https://hell.<your-subdomain>.workers.dev
  "workers_dev": true,
  // No extra per-version preview addresses: HELL has one public address.
  "preview_urls": false,
  "assets": {
    // Built by: HELL_TARGET=cloudflare npm run build (in frontend/)
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API runs before static files; everything else is the app.
    "run_worker_first": ["/v1/*", "/health"]
  },
  "observability": { "enabled": true }
}
